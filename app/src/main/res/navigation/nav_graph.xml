<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.gesturerecognizer.MainFragment"
        android:label="Main"
        tools:layout="@layout/fragment_main" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.gesturerecognizer.ProfileFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_dataCollectorFragment"
            app:destination="@id/dataCollectorFragment" />
        <action
            android:id="@+id/action_profileFragment_to_accountSettingsFragment"
            app:destination="@id/accountSettingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_notificationSettingsFragment"
            app:destination="@id/notificationSettingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountSettingsFragment"
        android:name="com.example.gesturerecognizer.AccountSettingsFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account_settings" />
    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="com.example.gesturerecognizer.NotificationSettingsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notification_settings" />
    <fragment
        android:id="@+id/dataCollectorFragment"
        android:name="com.example.gesturerecognizer.DataCollectorFragment"
        android:label="Data Collector"
        tools:layout="@layout/fragment_data_collector" />
</navigation>
